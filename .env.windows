# Windows-specific configuration for Stakazo
# This file contains Windows-optimized settings

# Paths (Windows-style)
LOG_DIR=backend\logs
TEMP_DIR=storage\temp
UPLOAD_DIR=storage\uploads

# Windows process settings
WORKER_PROCESS_TIMEOUT=300
MAX_WORKER_PROCESSES=4

# Windows-specific features
ENABLE_WINDOWS_SERVICE=false
WINDOWS_EVENT_LOG=false

# File handling
USE_WINDOWS_PATHS=true
NORMALIZE_PATH_SEPARATORS=true

# Security (Windows)
ENABLE_NTLM_AUTH=false
WINDOWS_INTEGRATED_AUTH=false

# Performance (Windows-optimized)
ASYNC_IO_THREADS=8
THREAD_POOL_SIZE=16

# Logging (Windows paths)
LOG_FILE=backend\logs\stakazo.log
ERROR_LOG_FILE=backend\logs\error.log
ACCESS_LOG_FILE=backend\logs\access.log

# Development (Windows)
BROWSER_AUTO_OPEN=false
HOT_RELOAD_PATHS=backend\app
WATCH_EXTENSIONS=.py,.yaml,.json,.env
