async def worker_loop(poll_interval: int = 5) -> None:            "status": "failed",

    """            "error": str(e)

    Main worker loop that polls for pending jobs.        }

    
    Args:
        poll_interval: Seconds between polling cycles
    """
    logger.info(f"Worker loop started with poll interval {poll_interval}s")
    
    while True:
        try:
            async with async_session_maker() as db:
                # Find pending jobs
                result = await db.execute(
                    select(Job)
                    .filter(Job.status == JobStatus.PENDING)
                    .limit(10)
                )
                pending_jobs = result.scalars().all()
                
                if pending_jobs:
                    logger.info(f"Found {len(pending_jobs)} pending jobs")
                    
                    # Process jobs
                    for job in pending_jobs:
                        await process_single_job(job.id, db)
                
        except Exception as e:
            logger.error(f"Worker loop error: {str(e)}")
        
        await asyncio.sleep(poll_interval)
