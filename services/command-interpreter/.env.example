# GPT-5 integration (set these to enable real GPT-5 calls)
GPT5_API_URL=https://api.example.com/v1/gpt5_generate
GPT5_API_KEY=your_api_key_here

# Optional system prompt for the command interpreter
COMMAND_INTERPRETER_SYSTEM_PROMPT="Eres un intérprete que convierte instrucciones en acciones JSON: {\"action\":..., \"params\":..., \"message\":...}. Responde únicamente con JSON.`"
