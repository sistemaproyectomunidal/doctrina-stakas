# Example environment variables for services/command-interpreter
# Copy this file to `.env` and fill with real values. DO NOT COMMIT the real `.env` file.

# AI / LLM (required for live GPT-5 interpretation)
GPT5_API_KEY=
GPT5_API_URL=https://api.openai.example/v1/generate
COMMAND_INTERPRETER_SYSTEM_PROMPT=Eres un intérprete que convierte instrucciones en acciones JSON: {"action":..., "params":..., "message":...}. Responde únicamente con JSON.

# E2B sandbox
E2B_SANDBOX_KEY=
E2B_API_URL=https://sandbox.e2b.example/api

# Optional: explicit service endpoints (overrides defaults used by orchestrator)
SERVICE_MONITOR_URL=http://localhost:8101
ML_ENGINE_URL=http://localhost:8102
SOCIAL_AUTOMATION_URL=http://localhost:8103
MUSIC_PRODUCTION_URL=http://localhost:8104

# Security
API_KEY_COMMAND_INTERPRETER=
ORCHESTRATOR_API_KEY=
JWT_SECRET=
CORS_ALLOWED_ORIGINS=*

# Persistence (optional for metrics / cost tracking)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=doctrina
POSTGRES_USER=doctrina
POSTGRES_PASSWORD=

# Observability
SENTRY_DSN=
OTEL_COLLECTOR_URL=

# Misc
LOG_LEVEL=INFO
ENV=development
