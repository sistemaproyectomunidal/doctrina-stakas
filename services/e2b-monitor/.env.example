# E2B Monitor - Archivo de Ejemplo de Variables de Entorno
# Copia este archivo a .env y rellena los valores

# Aplicación
DEBUG=False
HOST=0.0.0.0
PORT=8001
RELOAD=True

# E2B API
E2B_API_KEY=your_e2b_api_key_here
E2B_TIMEOUT=30

# Límites
MAX_EXECUTION_TIMEOUT=300
MAX_CONCURRENT_EXECUTIONS=10
MAX_CODE_LENGTH=10000

# Rate Limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_PER_MINUTE=60

# Logging
LOG_LEVEL=INFO

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8501,http://localhost:8000

# Base de Datos (opcional)
DATABASE_URL=postgresql://user:password@localhost:5432/e2b_monitor
